      "name": "🔐 ADM Autenticação",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response body has required fields\", function () {\n    const json = pm.response.json();\n    pm.expect(json).to.have.property(\"usuarioId\");\n    pm.expect(json).to.have.property(\"nome\");\n    pm.expect(json).to.have.property(\"email\");\n    pm.expect(json).to.have.property(\"perfil\");\n    pm.expect(json).to.have.property(\"accessToken\");\n    pm.expect(json).to.have.property(\"tokenType\");\n    pm.expect(json).to.have.property(\"expiresIn\");\n});\n\npm.test(\"tokenType equals 'Bearer'\", function () {\n    const json = pm.response.json();\n    pm.expect(json.tokenType).to.eql(\"Bearer\");\n});\n\npm.test(\"accessToken is a non-empty string\", function () {\n    const json = pm.response.json();\n    pm.expect(json.accessToken).to.be.a(\"string\").and.to.have.length.above(0);\n});\n\npm.test(\"expiresIn is a number\", function () {\n    const json = pm.response.json();\n    pm.expect(json.expiresIn).to.be.a(\"number\");\n});\n\npm.environment.set(\"jwt_token\", pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@raizes.com\",\n  \"senha\": \"Admin@123\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
